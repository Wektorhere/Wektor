OPENROUTER_API_KEY=
OPENROUTER_MODELS=openai/gpt-oss-120b:free,google/gemma-4-31b-it:free,cohere/north-mini-code:free,nvidia/nemotron-3-super-120b-a12b:free,openrouter/free
# Optional: override the single model used for each direct (non-OpenRouter)
# provider. Defaults are set in engine.py's _call_openai/_call_anthropic/
# _call_google — these go stale over time same as OPENROUTER_MODELS, so
# override here rather than editing code if a provider ships a new model.
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# GOOGLE_MODEL=gemini-2.5-flash